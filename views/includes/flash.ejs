<div class="flash-message">
    <% if (success.length) { %>
        <div class="row m-0">
            <div id="message-alert" class="alert alert-success alert-dismissible fade show mt-3 col-6 offset-3" role="alert">
                <div class="message"><%- success %> </div>
                <div class="flash-progress"></div>
            </div>
        </div>

    <% } %>

    <% if (error.length) { %>
        <div class="row m-0">
            <div id="message-alert" class="alert alert-danger alert-dismissible fade show mt-3 col-6 offset-3" role="alert">
                <div class="message"><%- error %> </div>
                <div class="flash-progress"></div>
            </div>
        </div>
        

    <% } %>


</div>