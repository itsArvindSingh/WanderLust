<%- layout("/layouts/boilerplate") %>
<body>
    
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="mt-3">Create a new Listing:</h3>
            <form class="needs-validation" 
                method="post" 
                action="/listings" 
                enctype="multipart/form-data" 
                novalidate >
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input 
                        class="form-control" 
                        id="title" 
                        type="text" 
                        name="listing[title]" 
                        placeholder="Enter Title"
                        required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please Enter Title</div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea 
                        class="form-control" 
                        id="description" 
                        name="listing[description]"
                        placeholder="Enter Description"
                        required></textarea>
                        <div class="invalid-feedback">Please Enter Description</div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input 
                        name="listing[image]" 
                        type="file"
                        class="form-control"/>
                </div>

                <div class="row">

                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input 
                            class="form-control" 
                            id="price" 
                            type="number"  
                            name="listing[price]" 
                            placeholder="Enter Price" 
                            required>
                            <div class="invalid-feedback">Please enter valid price</div>
                    </div>
                    
                    <div class="mb-3 col-md-6">
                        <label class="form-label" for="country">Country</label>
                        <select class="form-select" id="country" name="listing[country]" required>
                            <option value="" selected>Select a Country</option>
                            <% countryList.forEach(function(country) { %>
                                <option value="<%= country.code %>">
                                    <%= country.name %>
                                </option>
                            <% }); %>
                        </select>
                            <div class="invalid-feedback">Please Enter Country Name</div>
                    </div>   
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="type" class="form-label">Type</label>
                        <select class="form-select" id="type" name="listing[type]" required>
                            <option value="" selected>Select Type</option>
                            <%  getTypes().forEach((type) => { %>
                                <option value="<%= type.value %>"><%= type.label %></option>
                            <% });  %>
                            
                           
                        </select>
                    </div>


                    <div class="mb-3 col-md-6">
                        <label class="form-label" for="category">Category</label>
                        <select class="form-select" id="category" name="listing[category]" required>
                            <option value="" selected>Select Category</option>
                            <% getCategories().forEach(category => { %>
                                <option value="<%= category.value %>"><%= category.label %></option>
                            <% }); %>
                        </select>
                        <div class="invalid-feedback">Please select a category</div>
                    </div>
                </div>

                

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input 
                        class="form-control" 
                        for="location" 
                        type="text" 
                        name="listing[location]" 
                        placeholder="Enter Location" 
                        required>
                        <div class="invalid-feedback">Please Enter Location</div>
                </div>

                <button class="btn btn-dark mb-3 new-btn">Add</button>
            </form>
        </div>
    </div>
</body>
