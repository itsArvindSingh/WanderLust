<%- layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="mt-3">Edit Your Listing:</h3>
            <form  class="needs-validation" method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate>

                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input 
                        class="form-control" 
                        id="title" type="text" 
                        name="listing[title]"
                        value=" <%= listing.title %>"
                        required>
                        <div class="invalid-feedback">Please Enter Title</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea 
                        class="form-control" 
                        id="description" 
                        name="listing[description]"
                        required
                    ><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please Enter Description</div>
                </div>
                

                <div class="mb-3">
                    <label class="form-label" for="image">Image</label>
                    <textarea  
                        class="form-control" 
                        id="image" 
                        name="listing[image]"
                        required
                        ><%= listing.image %></textarea>
                        <div class="invalid-feedback">Please Enter Image Link</div>
                </div>
                
                <div class="row">
                    <div class="mb-3 col-4">
                        <label class="form-label" for="price">Price</label>
                        <input 
                            class="form-control" 
                            id="price"
                            type="number" 
                            name="listing[price]" 
                            value="<%= listing.price %>"
                            step="1"
                            required>
                            <div class="invalid-feedback">Please Enter Valid Price</div>
                    </div>
                    
                    <div class="mb-3 col-4">
                        <label class="form-label" for="country">Country</label>
                        <input 
                            class="form-control" 
                            id="country" 
                            type="text" 
                            name="listing[country]" 
                            value="<%= listing.country %>"
                            required>
                            <div class="invalid-feedback">Please Enter Country</div>
                    </div>
                    

                    <div class="mb-3 col-4">
                        <label class="form-label" for="type">Type</label>
                        <input 
                            class="form-control" 
                            id="type" 
                            type="text" 
                            name="listing[type]" 
                            value="<%= listing.type %>"
                            required>
                            <div class="invalid-feedback">Please Enter Type</div>
                    </div>

                </div>
                
                

                <div class="mb-3">
                        <label class="form-label" for="location">Location</label>
                        <input 
                            class="form-control" 
                            id="location" 
                            type="text" 
                            name="listing[location]" 
                            value="<%= listing.location %>"
                            required>
                            <div class="invalid-feedback">Please Enter Valid Location</div>
                </div>
                
                <button class="btn btn-dark new-btn mb-3">Save</button>

            </form>
        </div>
    </div>
</body>
