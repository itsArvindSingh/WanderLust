<%- layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-3 mt-3">
            <h3><b><%= listing.title %></b><br></h3>
        </div>
        <div class="card detailed-card col-6 offset-3 listing-card">
            <img src="<%= listing.image %>" class="show-card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %> <br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                    <%= listing.location %> <br>
                    <%= listing.country %>
                </p>
            </div>
        </div>
    

    
        <div class="btns col-8 offset-3">
            <form method="get" action="/listings/<%= listing._id %>/edit">
                <button class="btn btn-dark new-btn mb-3 me-3">Edit</button>
            </form>
        
        
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark mb-3">Delete</button>
            </form>
        </div>
    
        <div class="col-8 offset-3"> 
            <hr>
            <h4>Leave a review</h4>
            <form 
                class="needs-validation mb-3"
                novalidate
                action="/listings/<%= listing._id %>/reviews"
                method="POST">

                <div class="mb-3 mt-3">
                    <label for="rating"
                        class="form-label">Rating</label>
                    <div style="width: 25rem; max-width: 100%;">
                        <input type="range"
                        min="1"
                        max="5"
                        name="review[rating]"
                        class="form-range"
                        step=".1"
                        id="rating">
                    </div>
                        <output 
                            for="rating"
                            id="ratingValue"
                            aria-hidden="true"></output>
                </div>
                

                <div class="mb-3" >
                    <label  
                        for="comment"
                        class="form-label"
                        >Comments</label><br>
                        <textarea 
                            name="review[comment]" 
                            id="comment"
                            cols="50"
                            rows="5"
                            required></textarea>
                            <div class="invalid-feedback">Please Write Comment! </div>
                            
                </div>
                
                <button class="btn btn-outline-dark mb-3">Submit a review</button>
            </form>

            <div class="row">
                <p><b>All Reviews</b></p>
                <% for( review of listing.reviews ) { %>
                    <div class="card col-5  ms-3 mb-3">
                        <h4 class="mt-3">Rahul Bhatiya</h4>
                        <p><%= review.comment  %>,</p>
                        <p><%= review.rating %> stars</p>
                        <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>

                    </div>
                <% } %>
            </div>
            
                


        </div>

    </div>

<script>
    const ratingInput = document.getElementById("rating");
    const ratingOutput = document.getElementById("ratingValue");

    ratingOutput.textContent = ratingInput.value;

    ratingInput.addEventListener("input", (e) => {
        ratingOutput.textContent = e.target.value;
    })
</script>
</body>


