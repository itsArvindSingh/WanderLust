<%- layout("/layouts/boilerplate") %> 
<body>
    <style>
    .filter{
             margin-top: 2rem;
             margin-right: 2rem;
             text-align: center;
             opacity: 0.7;
    }

    .filter:hover{
        opacity: 1 ;
        cursor: pointer;
    }
    #filters{
        display: flex;
        flex-wrap: wrap;
    }

    .filter p{
        font-size: 0.8rem;
    }
    </style>
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-dungeon"></i></div>
            <p>Caves</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-house-chimney-window"></i></div>
            <p>Luxury</p>
        </div>

        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p> 
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-tree"></i></div>
            <p>Cabins</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beachfront</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>


        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault"></label>
            </div>
        </div>

    </div>
    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 mt-3">
        <% for( listing of allListings ) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card show-card col listing-card">
                    <div style="position: relative; width: 100%;">
                        <img src="<%= listing.image.url %>" 
                            class="all-card-img-top" 
                            alt="listing_image"
                            style="height: 18rem; width: 100%; object-fit: cover;">
                        
                        <!-- Text Overlay on Image -->
                        <div style="position: absolute;
                                    top: 12px;
                                    left: 12px; 
                                    background: rgba(255, 255, 255, 0.95);
                                    color: #222; 
                                    font-size: 12px; 
                                    font-weight: 500;
                                    letter-spacing: 0.3px;
                                    padding: 4px 12px;
                                    border-radius: 20px;
                                    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                                    backdrop-filter: blur(4px);
                                    border: 1px solid rgba(255, 255, 255, 0.3);">
                            <%= listing.type.charAt(0).toUpperCase() + listing.type.slice(1).toLowerCase()  %>

                        </div>
                    </div>

                    <div class="card-body">
                        <p class="card-text">
                            <b style="font-weight: 500;"><%= listing.title %></b> <br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night <br>
                            <span style="font-weight: 300; margin: 0; padding: 0;"><%= listing.country %></span>
                            
                        </p>
                    </div>
                </div>
            </a>
        <% } %>     
